# ---- Public (safe to ship in the browser bundle) ----
# Privy application id. A public client identifier, not a secret. Falls back to the shared app.
PUBLIC_PRIVY_APP_ID=
# 46630 = Robinhood Chain Testnet (proving), 4663 = Robinhood Chain (launch).
PUBLIC_CHAIN_ID=4663
# Where pay links point, e.g. https://tweetsend-site.vercel.app
PUBLIC_SITE_URL=

# ---- Server only (Vercel project env + worker host). Entered by the client. Never printed. ----
# Neon Postgres. Provisioned via the Vercel marketplace (see README).
DATABASE_URL=
# Privy app secret: lets the server resolve who is signed in and pre-make wallets for recipients.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# X API — app bearer token for reads; OAuth 1.0a user keys of the BOT account for replies.
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# The bot's handle without @ (default TweetSend).
X_BOT_HANDLE=TweetSend

# ---- Development only ----
# DEV_FAKE_AUTH=1 lets the E2E script use an `x-dev-user` header instead of a Privy session. Ignored in production builds.
DEV_FAKE_AUTH=
TICK_TOKEN=          # random string that lets a cron call /api/tick (make one: openssl rand -hex 24)
