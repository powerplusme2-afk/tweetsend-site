---
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
  /** The landing page is the light marketing face; product pages run the dark Rulepad-style shell. */
  kit?: 'site' | 'app';
}
const {
  title = 'TweetSend — Send crypto directly under a tweet.',
  description = 'Reply @TweetSend and an amount under any tweet. The money goes to the person who wrote it, in USDG on Robinhood Chain, to a wallet that is theirs the moment they sign in with X.',
  kit = 'site',
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={'#000243'} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {kit === 'app' && <link rel="preload" as="font" type="font/woff2" href="/fonts/NeueMontreal-Regular.woff2" crossorigin />}
    {kit === 'app' && <link rel="preload" as="font" type="font/woff2" href="/fonts/jetbrainsmono-latin-2c32b9b3.woff2" crossorigin />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body class:list={[kit === 'app' && 'on-dark']}>
    <slot />
  </body>
</html>
