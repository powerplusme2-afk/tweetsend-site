---
/**
 * The app chrome: the Rulepad dashboard shell, copied 1:1 (client, 14 Sep
 * 2026) — a dark sidebar (brand, nav, account) beside the main column, and a
 * fixed bottom bar on phones.
 *
 * Privy portals the identity chip into [data-privy-chip]; before it mounts
 * that slot is empty rather than showing a control that claims a connection.
 * The account block at the foot of the sidebar is filled by bootShell from
 * the same bridge.
 */
import { PrivyApp } from '../../app/privy';

interface Props {
  title: string;
  sub?: string;
  active: 'activity' | 'send' | 'claims' | 'settings' | 'pay' | 'none';
}
const { title, sub, active } = Astro.props;

/* The marketing site; its every CTA points back at /app here. */
const SITE_URL = 'https://tweetsend-vivid.vercel.app/';

const links = [
  { href: '/app', label: 'Activity', key: 'activity' },
  { href: '/app/send', label: 'Send', key: 'send' },
  { href: '/app/claims', label: 'Claims', key: 'claims' },
  { href: '/app/settings', label: 'Settings', key: 'settings' },
];
---

<div class="shell on-dark">
  <aside class="side">
    <a class="brand" href={SITE_URL} title="TweetSend — the site">
      <img src="/brand/mark.svg" alt="" width="128" height="128" />
      <span>TweetSend</span>
    </a>
    <nav aria-label="App">
      {links.map((l) => (
        <a href={l.href} class:list={[active === l.key && 'is-on']} aria-current={active === l.key ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
    <div class="grow"></div>
    <a class="site-link" href={SITE_URL}>tweetsend-vivid.vercel.app ↗</a>
    {/* No `data-account` here: the Settings page owns that hook for its account list. */}
    <a class="account" href="/app/settings">
      <span class="avatar" data-avatar>T</span>
      <span>
        <b data-account-name>Account</b>
        <small data-account-mail></small>
      </span>
    </a>
  </aside>

  <div class="main" id="main">
    <div class="notice is-warn" data-xlogin-off hidden>
      <b>Sign in with X is not switched on in the Privy app yet.</b>
      Until it is, sign-in here is email or wallet, and money cannot be addressed to an @handle.
      Turn it on in the Privy dashboard → Login methods → Twitter (X).
    </div>
    <div class="topbar">
      <div>
        <h1>{title}</h1>
        {sub && <p class="sub">{sub}</p>}
      </div>
      <div class="topbar-actions">
        <slot name="actions" />
        <div data-privy-chip></div>
      </div>
    </div>
    <slot />
  </div>
</div>

<nav class="mob-bar" aria-label="App">
  {links.map((l) => (
    <a href={l.href} class:list={[active === l.key && 'is-on']}>{l.label}</a>
  ))}
</nav>

<PrivyApp client:only="react" />

<script is:inline>
  /* If the wallet island never publishes a bridge, publish a failed one so
     buttons can say what went wrong instead of sitting on "Loading…". */
  (function () {
    setTimeout(function () {
      if (window.__tweetsendPrivy) return;
      var short = 'Sign-in failed to load — reload';
      window.__tweetsendPrivy = {
        configured: false, ready: true, authenticated: false, xLogin: false, x: null,
        address: null, signer: null, email: null, chainId: null, embedded: false,
        provider: null, switchChain: null, accessToken: null, identityToken: null,
        reason: short, login: function () { location.reload(); }, logout: function () {}, linkX: null,
      };
      var host = document.querySelector('[data-privy-chip]');
      if (host && !host.firstChild) {
        var btn = document.createElement('button');
        btn.className = 'chip is-off';
        btn.type = 'button';
        btn.addEventListener('click', function () { location.reload(); });
        var dot = document.createElement('span');
        dot.className = 'dot';
        var label = document.createElement('span');
        label.textContent = short;
        btn.appendChild(dot);
        btn.appendChild(label);
        host.appendChild(btn);
      }
      window.dispatchEvent(new Event('tweetsend:wallet'));
    }, 8000);
  })();
</script>
