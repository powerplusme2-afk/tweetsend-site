---
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const {
  title = 'TweetSend — Send crypto directly under a tweet.',
  description = 'Reply @TweetSend and an amount under any tweet. The money goes to the person who wrote it, in USDG on Robinhood Chain, to a wallet that is theirs the moment they sign in with X.',
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#2e96ff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <slot />
  </body>
</html>
